[Unit]
Description=studio: music rendering and transcription (127.0.0.1:8790, tailnet https://lenovo)
After=network-online.target
Wants=network-online.target
[Service]
User=chinmay
WorkingDirectory=/home/chinmay/studio
ExecStart=/home/chinmay/studio/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8790
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
